@model List<wt_lab4_4mvc_strelchonok.Models.Book>

@{
    ViewData["Title"] = "Каталог книг";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📚 Каталог книг</h1>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            ➕ Добавить книгу
        </a>
    </div>

    <p class="text-muted">
        Всего книг в библиотеке: <span class="badge bg-primary">@Model.Count</span>
    </p>

    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4 border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@book.Title</h5>
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success">В наличии</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Нет в наличии</span>
                            }
                        </div>

                        <p class="text-muted small mb-1">@book.Author</p>
                        <p class="text-muted small mb-3">
                            @book.Genre · @book.Year г. · @book.Pages стр.
                        </p>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@book.Id"
                               class="btn btn-outline-primary btn-sm">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-4">
            В библиотеке пока нет книг.
        </div>
    }
</div>